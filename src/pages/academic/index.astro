---
import PageLayout from '@/layouts/CommonPage.astro'
import {
  Button,
  Icon,
  PublicationSection,
  ResearchProjectSection,
  SimpleIcon
} from '@/components/user'
import { getAcademicPage } from '@/data/site-pages'
import config from '@/site-config'

const page = getAcademicPage('zh')

// Sections with no content are hidden, together with their table-of-contents entry
const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me', show: page.about.length > 0 || !!page.cvUrl },
  { depth: 2, slug: 'research-interests', text: 'Research Interests', show: page.interests.length > 0 },
  { depth: 2, slug: 'publications', text: 'Publications', show: page.publications.length > 0 },
  { depth: 2, slug: 'open-source-projects', text: 'Open-source Projects', show: page.openSource.length > 0 }
]
  .filter((h) => h.show)
  .map(({ depth, slug, text }) => ({ depth, slug, text }))
---

<PageLayout title='Academic' {headings} info={{ slug: '/academic', hideComment: true }}>
  {
    (page.about.length > 0 || page.cvUrl) && (
      <>
        <h2 id='about-me'>
          About Me<a class='anchor' href='#about-me'>#</a>
        </h2>
        {page.about.map((text) => <p>{text}</p>)}
        {page.cvUrl && (
          <>
            <p>这是我的学术简历，欢迎下载。</p>
            <Button title='下载简历' class='w-fit' href={page.cvUrl} target='_blank'>
              <Icon class='size-5' name='download' slot='before' />
            </Button>
          </>
        )}
      </>
    )
  }
  {
    page.interests.length > 0 && (
      <>
        <h2 id='research-interests'>
          Research Interests<a class='anchor' href='#research-interests'>#</a>
        </h2>
        <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
          {page.interests.map((interest) => (
            <div class='group relative overflow-hidden rounded-xl border border-border bg-card p-4 transition-all hover:border-foreground/25 hover:shadow-md'>
              <div class='flex items-start gap-4'>
                {interest.icon && (
                  <div class='flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/20'>
                    <SimpleIcon
                      class='size-5 text-primary transition-transform duration-300 group-hover:scale-110'
                      name={interest.icon}
                    />
                  </div>
                )}
                <div class='flex-1'>
                  <p class='text-xl font-medium leading-tight text-foreground transition-colors group-hover:text-primary'>
                    {interest.title}
                  </p>
                  <p class='text-sm leading-relaxed text-muted-foreground'>{interest.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </>
    )
  }
  {
    page.publications.length > 0 && (
      <>
        <h2 id='publications'>
          Publications<a class='anchor' href='#publications'>#</a>
        </h2>
        <PublicationSection publications={page.publications} />
      </>
    )
  }
  {
    page.openSource.length > 0 && (
      <>
        <h2 id='open-source-projects'>
          Open-source Projects<a class='anchor' href='#open-source-projects'>#</a>
        </h2>
        <ResearchProjectSection projects={page.openSource} />
      </>
    )
  }
</PageLayout>

<script
  is:inline
  type='module'
  data-astro-rerun
  define:vars={{ npmCDN: config.npmCDN, walineServer: config.integ.waline.server }}
>
  const normalizePath = (path) => {
    if (path === '/') return path
    return path.endsWith('/') ? path.slice(0, -1) : path
  }

  const loadPageviewCount = async () => {
    const pageview = await import(`${npmCDN}/@waline/client@v3/dist/pageview.js`)
    pageview.pageviewCount({
      serverURL: walineServer,
      path: normalizePath(window.location.pathname)
    })
  }

  if (walineServer) await loadPageviewCount()
</script>
